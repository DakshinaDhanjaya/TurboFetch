{
  "manifest_version": 3,
  "name": "TurboFetch Download Manager",
  "version": "1.0.0",
  "description": "Automatically catch browser downloads and accelerate them with TurboFetch.",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "activeTab",
    "cookies",
    "tabs",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
