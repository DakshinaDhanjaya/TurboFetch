{
  "manifest_version": 2,
  "name": "TurboFetch Download Manager",
  "version": "1.0.0",
  "description": "Automatically catch browser downloads and accelerate them with TurboFetch.",
  "browser_specific_settings": {
    "gecko": {
      "id": "turbofetch@turbofetch.org",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "activeTab",
    "cookies",
    "tabs",
    "notifications",
    "<all_urls>",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
